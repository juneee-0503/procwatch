# procwatch as a system service. See docs/deployment.md.
[Unit]
Description=procwatch computer monitor
After=network-online.target
Wants=network-online.target
# Don't let a broken program restart without end.
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=notify
NotifyAccess=main
User=procwatch
Group=procwatch
Environment=XDG_CONFIG_HOME=/etc XDG_DATA_HOME=/var/lib
ExecStart=/usr/local/bin/procwatch --agent /etc/procwatch/agent.yml --output /var/lib/procwatch/agent.jsonl
# always, not on-failure: SIGTERM and a clean exit must restart too.
Restart=always
RestartSec=2
WatchdogSec=60
TimeoutStopSec=15

# What it needs instead of being root.
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_RAW CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_LINUX_IMMUTABLE
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_RAW CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_LINUX_IMMUTABLE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/procwatch
# Lower, not immune: a leak here must not take the machine down with it.
OOMScoreAdjust=-100
UMask=0077

[Install]
WantedBy=multi-user.target
